     "e": 15.6
    }
   ],
   "cues": [
    {
     "s": 0.0,
     "e": 3.14,
     "text": "Куранда, Саба сүрөсүндө, мааниси боюнча мындай"
    },
    {
     "s": 3.16,
     "e": 5.58,
     "text": "делет: жакшылыкка эмне сарптасаңар,"
    },
    {
     "s": 5.6,
     "e": 7.66,
     "text": "Аллах анын ордун толтурат,"
    },
    {
     "s": 7.68,
     "e": 10.3,
     "text": "Ал — ырыскы берүүчүлөрдүн эң жакшысы."
    },
    {
     "s": 10.32,
     "e": 12.82,
     "text": "Бул акчага байлык убада кылуу эмес."
    },
    {
     "s": 12.84,
     "e": 15.95,
     "text": "Бул эскертүү: жакшылык жоголбойт."
    }
   ]
