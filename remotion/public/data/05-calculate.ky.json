    {
     "s": 0.0,
     "e": 3.22,
     "text": "Бешинчи кадам: калган сумманы эки жарым пайызга"
    },
    {
     "s": 3.24,
     "e": 6.62,
     "text": "көбөйтүңүз. Мисал үчүн сексен миң сомду алалы:"
    },
    {
     "s": 6.64,
     "e": 9.38,
     "text": "сексен миңди эки жарым пайызга көбөйтсөк —"
    },
    {
     "s": 9.4,
     "e": 10.62,
     "text": "эки миң сом чыгат."
    },
    {
     "s": 10.64,
     "e": 12.46,
     "text": "Бул жөн гана арифметика."
    },
    {
     "s": 12.48,
     "e": 15.073,
     "text": "Дал ушул суммадан зекет берүү керекпи —"
